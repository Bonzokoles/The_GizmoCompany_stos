{
  "name": "zeno-browser",
  "version": "0.1.0",
  "description": "THE_Zenon_browser - AI-powered web browser",
  "main": "dist-electron/src-electron/main.js",
  "scripts": {
    "start": "cross-env ELECTRON_IS_DEV=0 electron .",
    "dev": "npx kill-port 5173 && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "cross-env VITE_BUILD_TARGET=web vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:web": "cross-env VITE_BUILD_TARGET=web vite build",
    "deploy:web": "cross-env VITE_BUILD_TARGET=web vite build && npx shx cp -r ai-hub dist/ai-hub && npx wrangler pages deploy dist --project-name zeno-browser-web",
    "dev:web": "npx wrangler pages dev dist --port 8788",
    "studio": "npx localflare",
    "studio:attach": "npx localflare attach",
    "dist": "npm run build && electron-builder",
    "type-check": "tsc --noEmit",
    "lint": "eslint src src-electron --ext .ts,.tsx",
    "lint:fix": "eslint src src-electron --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"src-electron/**/*.ts\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --coverage",
    "test:coverage": "jest --coverage --coverageReporters=text-summary",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist dist-electron coverage",
    "curate": "node -e \"process.env.PYTHONIOENCODING='utf-8'; const {execSync}=require('child_process'); execSync('python ../The_DEVz_HUB_of_work/knowledge_base/_LIBRARIES/tools/curate_libraries.py', {stdio:'inherit', env:process.env})\"",
    "hub": "cd JIMBO_agent_HUB && npm start",
    "hub:install": "cd JIMBO_agent_HUB && npm install"
  },
  "dependencies": {
    "@cloudflare/tanstack-ai": "^0.1.4",
"@modelcontextprotocol/sdk": "^1.27.1",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "agents": "^0.7.9",
    "ai-gateway-provider": "^3.1.1",
    "axios": "^1.6.2",
    "better-sqlite3": "^12.8.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "lru-cache": "^10.1.0",
    "node-pty": "^1.1.0",
    "openai": "^6.33.0",
    "page-agent": "^1.6.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^9.0.0",
    "workers-ai-provider": "^3.1.4",
    "ws": "^8.20.0"
  },
  "build": {
    "appId": "org.zeno-browser.app",
    "productName": "ZENO Browser",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "ZENO-Browser-${version}-portable.exe"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/electron-is-dev/**"
    ],
    "compression": "store",
    "extraResources": []
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "localflare": "^0.5.0",
    "monaco-editor": "^0.52.0",
    "playwright": "^1.40.1",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "wait-on": "^7.1.0"
  }
}
