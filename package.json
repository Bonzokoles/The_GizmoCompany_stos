{
  "name": "zeno-browser",
  "version": "0.1.0",
  "description": "THE_Zenon_browser - AI-powered web browser",
  "main": "dist-electron/src-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:web": "vite build",
    "deploy:web": "vite build && npx shx cp -r ai-hub dist/ai-hub && npx shx cp -r movies-app dist/movies-app && npx wrangler pages deploy dist --project-name zeno-browser-web",
    "dev:web": "npx wrangler pages dev dist --port 8788",
    "studio": "npx localflare",
    "studio:attach": "npx localflare attach",
    "dist": "npm run build && electron-builder",
    "type-check": "tsc --noEmit",
    "lint": "eslint src src-electron --ext .ts,.tsx",
    "lint:fix": "eslint src src-electron --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"src-electron/**/*.ts\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --coverage",
    "test:coverage": "jest --coverage --coverageReporters=text-summary",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist dist-electron coverage",
    "curate": "node -e \"process.env.PYTHONIOENCODING='utf-8'; const {execSync}=require('child_process'); execSync('python ../The_DEVz_HUB_of_work/knowledge_base/_LIBRARIES/tools/curate_libraries.py', {stdio:'inherit', env:process.env})\""
  },
  "dependencies": {
    "@cloudflare/tanstack-ai": "^0.1.4",
    "@github/copilot-sdk": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "agents": "^0.7.9",
    "ai-gateway-provider": "^3.1.1",
    "axios": "^1.6.2",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "lru-cache": "^10.1.0",
    "page-agent": "^1.6.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^9.0.0",
    "workers-ai-provider": "^3.1.4",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "localflare": "^0.5.0",
    "playwright": "^1.40.1",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "wait-on": "^7.1.0"
  }
}
