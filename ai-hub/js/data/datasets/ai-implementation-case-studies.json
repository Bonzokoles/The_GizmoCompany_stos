  "common_mistakes": [
    {
      "mistake": "Starting without clear business metrics",
      "impact": "Can't measure ROI, hard to justify spending",
      "solution": "Define metrics first, then build model"
    },
    {
      "mistake": "Insufficient data engineering upfront",
      "impact": "Models fail in production, missed deadlines",
      "solution": "Allocate 25-35% of budget to data infrastructure"
    },
    {
      "mistake": "Pilot success != production success",
      "impact": "Scaling failures, hidden costs emerge",
      "solution": "Plan scale phase with different data and load conditions"
    },
    {
      "mistake": "Ignoring model retraining schedules",
      "impact": "Model drift, accuracy degradation over time",
      "solution": "Build monitoring and retraining into ops from day one"
    },
    {
      "mistake": "Underestimating change management",
      "impact": "Staff resistance, low adoption",
      "solution": "Include training and change mgmt in budget (15-25%)"
    },
    {
      "mistake": "Overcomplicating initial models",
      "impact": "Slower deployment, harder to maintain",
      "solution": "Start simple, iterate based on production feedback"
    }
  ],
