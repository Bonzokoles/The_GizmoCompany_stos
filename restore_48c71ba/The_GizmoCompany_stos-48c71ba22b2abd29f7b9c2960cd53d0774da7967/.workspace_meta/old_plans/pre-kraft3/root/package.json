{
  "name": "zeno-browser",
  "version": "0.1.0",
  "description": "ZENO Browser - AI-powered web browser",
  "type": "module",
  "main": "dist-electron/src-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:astro\" \"npm run dev:electron\"",
    "dev:astro": "astro dev --port 4378",
    "dev:electron": "wait-on http://localhost:4378 && electron .",
    "build": "npm run build:astro && npm run build:electron",
    "build:astro": "astro build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "astro preview",
    "astro": "astro",
    "dist": "npm run build && electron-builder",
    "type-check": "tsc --noEmit",
    "lint": "eslint src src-electron --ext .ts,.tsx",
    "lint:fix": "eslint src src-electron --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"src-electron/**/*.ts\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --coverage",
    "test:coverage": "jest --coverage --coverageReporters=text-summary",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist dist-electron coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@tavily/core": "^0.7.2",
    "astro": "^5.17.1",
    "axios": "^1.6.2",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.2.0",
    "crypto-js": "^4.2.0",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.8.3",
    "fs-extra": "^11.2.0",
    "lru-cache": "^10.1.0",
    "openai": "^6.7.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-terminal-ui": "^1.4.0",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.18",
    "tavily": "^1.0.2",
    "uuid": "^9.0.0",
    "webamp": "^2.2.0",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.2.37",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.40.1",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "vitest": "^1.2.0",
    "wait-on": "^7.1.0",
    "wrangler": "^4.45.4"
  }
}
